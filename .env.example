# ============================================================================
# CCIP Environment Variables - Development
# ============================================================================
# Copy this file to .env.local and fill in your actual values
# Never commit .env.local to git (it's in .gitignore)
# ============================================================================

# ============================================================================
# DATABASE & AUTHENTICATION
# ============================================================================
# Get these from Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Use ONLY in server code (API routes, server components)
# Get from Supabase > Project Settings > API > Service Role Secret (keep secret!)
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# INSTITUTIONAL CONFIGURATION
# ============================================================================
# The institutional domain for OAuth (e.g., university.edu.ph, college.ac.uk)
# Users can only sign up/log in with emails ending in this domain
INSTITUTIONAL_DOMAIN=

# University/Organization name for display
ORG_NAME=

# ============================================================================
# GOOGLE OAUTH 2.0
# ============================================================================
# Get these from Google Cloud Console > Credentials > OAuth 2.0 Client ID
# https://console.cloud.google.com/

# Your Google OAuth Client ID (public, safe in NEXT_PUBLIC_)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Your Google OAuth Client Secret (KEEP SECRET - server only)
GOOGLE_CLIENT_SECRET=

# OAuth callback URL - must match Google Cloud Console exactly
NEXT_PUBLIC_AUTH_CALLBACK_URL=http://localhost:3000/auth/callback/google

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# Node environment: development, production, test
NODE_ENV=development

# Next.js public URL (used for OG tags, email links, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================================
# OPTIONAL: EMAIL SERVICE (Phase 4+)
# ============================================================================
# For transactional emails via Resend.com
RESEND_API_KEY=

# ============================================================================
# OPTIONAL: SOCIAL MEDIA (Phase 5+)
# ============================================================================
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================
#
# 1. CREATE SUPABASE PROJECT
#    - Go to https://app.supabase.com
#    - Create a new project (PostgreSQL database)
#    - Wait for database initialization (~2 min)
#    - Navigate to Project Settings > API to copy NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY
#    - Navigate to Project Settings > API > Service Role Secret tab to copy SUPABASE_SERVICE_ROLE_KEY
#
# 2. CREATE GOOGLE OAUTH CREDENTIALS
#    - Go to https://console.cloud.google.com
#    - Create a new project (e.g., "CCIP")
#    - Enable Google+ API
#    - Go to Credentials > Create OAuth 2.0 Client ID > Web application
#    - Add authorized JavaScript origins: http://localhost:3000
#    - Add authorized redirect URIs: http://localhost:3000/auth/callback/google
#    - Copy NEXT_PUBLIC_GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET
#
# 3. CONFIGURE SUPABASE OAUTH
#    - In Supabase > Authentication > Providers > Google
#    - Enter your NEXT_PUBLIC_GOOGLE_CLIENT_ID
#    - Enter your GOOGLE_CLIENT_SECRET
#    - Add http://localhost:3000 as default redirect URL
#    - Enable the Google provider
#
# 4. RUN DATABASE MIGRATIONS
#    - See PRE_PHASE_1_SETUP.md Section 2.1 for all 11 SQL migrations
#    - Manually paste each migration into Supabase > SQL Editor > Run
#    - Verify all tables created (auth.users, organizations, content, roles, etc.)
#
# 5. SEED INITIAL DATA
#    - Insert SUPER_ADMIN user into auth.users and users table
#    - Insert root organization into organizations table
#    - See PRE_PHASE_1_SETUP.md Section 2.2 for exact SQL
#
# 6. START DEVELOPMENT SERVER
#    npm run dev
#    Open http://localhost:3000
#
# ============================================================================
