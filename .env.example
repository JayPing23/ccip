# ============================================================================
# CCIP Environment Variables - Development
# ============================================================================
# Copy this file to .env.local and fill in your actual values.
# Never commit .env.local to git (it is already in .gitignore).
# ============================================================================

# ============================================================================
# DATABASE & AUTHENTICATION
# ============================================================================
# Get these from Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Use ONLY in server code (API routes, server components)
# Get from Supabase > Project Settings > API > Service Role Secret (keep secret)
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# INSTITUTIONAL CONFIGURATION
# ============================================================================
# Institutional domain for OAuth and sign-in policy (e.g. university.edu.ph)
INSTITUTIONAL_DOMAIN=

# University or organization name for display
ORG_NAME=

# ============================================================================
# GOOGLE OAUTH 2.0
# ============================================================================
# Get these from Google Cloud Console > Credentials > OAuth 2.0 Client ID
# https://console.cloud.google.com/
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# Node environment: development, production, test
NODE_ENV=development

# Public app URL used for redirects, notification email links, and digest links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================================
# OPTIONAL: PHASE 2 EMAIL DELIVERY & DIGESTS
# ============================================================================
# Required only if you want immediate publish emails or scheduled digests.
RESEND_API_KEY=

# Optional custom sender. Must be a verified sender in your Resend account.
RESEND_FROM_EMAIL=

# Shared secret for /api/cron/digests/* authorization headers.
# Strongly recommended in any deployed environment.
CRON_SECRET=

# ============================================================================
# OPTIONAL: SOCIAL MEDIA / EXTERNAL DISTRIBUTION (Phase 5)
# ============================================================================
# Required for external distribution of announcements and articles to Facebook.
# Get from Facebook Developer Console > App Settings.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Required for external distribution to Instagram (via Facebook Graph API).
# Uses the same Facebook app credentials above plus an Instagram Business Account.
# INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================
#
# 1. CREATE SUPABASE PROJECT
#    - Go to https://app.supabase.com
#    - Create a new project (PostgreSQL database)
#    - Wait for database initialization
#    - Copy NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY,
#      and SUPABASE_SERVICE_ROLE_KEY from Project Settings > API
#
# 2. CREATE GOOGLE OAUTH CREDENTIALS
#    - Go to https://console.cloud.google.com
#    - Create a new project (for example, "CCIP")
#    - Enable Google+ API
#    - Create an OAuth 2.0 Client ID for a web application
#    - Add authorized JavaScript origins: http://localhost:3000
#    - Add authorized redirect URIs: http://localhost:3000/auth/callback/google
#    - Copy NEXT_PUBLIC_GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET
#
# 3. CONFIGURE SUPABASE OAUTH
#    - In Supabase > Authentication > Providers > Google
#    - Enter your NEXT_PUBLIC_GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET
#    - Add http://localhost:3000 as a default redirect URL
#    - Enable the Google provider
#
# 4. RUN DATABASE MIGRATIONS
#    - Follow docs/SETUP_GUIDE.md for the foundation setup flow
#    - Apply the SQL files under supabase/migrations/ in order
#    - Make sure 001_enable_rls_policies.sql and 002_content_full_text_search.sql are applied
#
# 5. SEED INITIAL DATA
#    - Follow docs/SETUP_GUIDE.md for initial data guidance
#    - Insert your bootstrap organization and first privileged user
#
# 6. OPTIONAL PHASE 2 EMAIL DELIVERY
#    - Create a Resend account and API key
#    - Verify the sender address or domain you plan to use
#    - Set RESEND_API_KEY and optionally RESEND_FROM_EMAIL
#
# 7. OPTIONAL DIGEST SCHEDULER
#    - Generate a strong CRON_SECRET
#    - Configure your scheduler to call /api/cron/digests/daily and /api/cron/digests/weekly
#    - Send Authorization: Bearer <CRON_SECRET>
#
# 8. START DEVELOPMENT SERVER
#    npm run dev
#    Open http://localhost:3000
#
# ============================================================================
